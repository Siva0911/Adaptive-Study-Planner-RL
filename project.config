# INI-style configuration; no TOML parser or extra dependency is needed.
# Command-line options override the corresponding settings below.
[run]
profile = full
output = new_results
matched = true
skip_scenarios = false

[full]
episodes = 40000
seeds = 10
eval_episodes = 500
tuning_episodes = 8000
scenario_episodes = 10000
scenario_seeds = 3
oracle_grid = 16

[smoke]
episodes = 1000
seeds = 1
eval_episodes = 30
tuning_episodes = 500
scenario_episodes = 1000
scenario_seeds = 1
oracle_grid = 8

[environment]
horizon = 20
forgetting = 0.06
consolidation = 0.45
recall = 0.18
rho = 0.45
burnout_penalty = 1.0
noise_std = 0.025
gamma = 1.0
fatigue_weight = 0.0
shaped = true
burnout_threshold = 1.0
break_recovery = 0.30
study_cost = 1.6
practice_cost = 1.0
review_cost = 0.65
